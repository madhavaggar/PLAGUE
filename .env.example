# Copy this file to `.env` and fill in the API keys for the providers you use.
# PLAGUE reads these via python-dotenv at import time.

# OpenAI (target/attacker/evaluator models such as o3, o1, gpt-4o)
OPENAI_API_KEY=

# Anthropic (target models such as claude-opus-4-1)
ANTHROPIC_API_KEY=

# Together AI (open-weight attacker/evaluator/summariser models, e.g. DeepSeek-R1,
# Llama-3.x, Qwen3-235B)
TOGETHER_API_KEY=

# Google Gemini (optional target models)
GEMINI_API_KEY=
